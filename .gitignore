# --- Secrets / personal data ---
# Live-verification probe outputs contain OAuth tokens & account data — never
# commit. Unanchored: matches at ANY depth (a stray scripts/gogo-probe/ copy was
# once committed and had to be purged from history before the first push).
gogo-probe/

# --- Local tooling state ---
/.pi/tasks/
/.pi/fusion/
/.direnv/

# --- Rust build (crate lands in implementation phase; Cargo.lock gets committed then) ---
/target/


# --- Nix ---
# `nix build` result symlinks.
/result
# --- Environment ---
.env
.env.*

# --- OS / editor noise ---
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# --- macOS app bundles (gogo mac-app output; never commit game content) ---
*.app/
