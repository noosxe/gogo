// Stock components (design 26 §5, depth C): ordinary components that other skins may copy, change or replace.

component "status-badge" params="status" {
    chip "{status.word(status)}" icon="dot" tone="{status}"
}

component "summary-tile" params="mark tone title sub link action args" {
    row style="tile" grow=1 {
        badge "{mark == 'check' ? '✓' : (mark == 'half' ? '½' : '!')}" style="mark" tone="{tone else 'neutral'}"
        column gap=2 grow=1 {
            text "{title}" style="tile-title"
            text "{sub}" style="tile-sub" when="{sub}"
            button "{link}" style="ghost link" h=20 padding=0 action="{action}" args="{args}" when="{link}"
        }
    }
}
