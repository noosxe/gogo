route "shell" {
    row style="frame" {
        scroll style="sidebar" id="nav" label="Navigation" {
            row style="brand" { text "go"; text "go" color=@accent }
            button "Search…" style="search" key="Ctrl K" action="palette.open" label="Search and commands" id="search"
            button "Library" icon="square" style="nav" action="nav.go" args="library" on="{route.current == library}" id="nav-library" {
                spacer
                badge "{library.stats.count}" style="count"
            }
            button "Queue" icon="circle" style="nav" action="nav.go" args="queue" on="{route.current == queue}" {
                spacer
                badge "{queue.summary.active}" style="count"
            }
            button "Updates" icon="square" style="nav" action="nav.go" args="updates" on="{route.current == updates}" {
                spacer
                badge "{library.stats.updates}" style="count" color=@warn
            }
            button "Cloud saves" icon="square" style="nav" action="nav.go" args="saves" on="{route.current == saves}"
            text "This machine" style="section-head"
            button "Installed apps" icon="square" style="nav" action="nav.go" args="apps" on="{route.current == apps}"
            button "Runtimes & renderers" icon="square" style="nav" action="nav.go" args="runtimes" on="{route.current == runtimes}"
            button "Doctor" icon="square" style="nav" action="nav.go" args="doctor" on="{route.current == doctor}" {
                spacer
                badge "{doctor.all | where summary.warn > 0 | len}" style="count" color=@warn
            }
            text "App" style="section-head"
            button "Settings" icon="circle" style="nav" action="nav.go" args="settings" on="{route.current == settings}"
            spacer
            let q="{queue.summary}"
            column style="mini" id="transfer" when="{q.current}" {
                row {
                    text "{q.current.game?.title else q.current.kind}" weight=700 grow=1
                    text "{fmt.pct(q.current.fraction)}" style="mini-meta" when="{q.current.fraction != null}"
                }
                box style="bar" when="{q.current.fraction != null}" { box style="bar-fill" progress="{q.current.fraction}" }
                row {
                    text "{fmt.rate(q.rate)}" style="mini-meta" grow=1
                    text "{fmt.eta(q.current.eta)}" style="mini-meta" when="{q.current.eta != null}"
                }
                text "+{q.queued} queued · rate limit {q.rate_limit ? fmt.rate(q.rate_limit) : 'off'}" style="mini-foot"
            }
            row style="account" when="{account.signed_in}" {
                dot tone="ready" style="dot-ok"
                text "{account.username}" when="{account.username}"
                text "Signed in" when="{not account.username}"
            }
            button "Sign in" style="nav" action="nav.go" args="sign-in" on="{route.current == 'sign-in'}" when="{not account.signed_in}"
        }
        scroll grow=1 id="main" {
            outlet
        }
    }
}
