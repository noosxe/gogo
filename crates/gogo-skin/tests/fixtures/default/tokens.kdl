// Round-1 Atelier dark set, as in the Default mockup.
tokens "dark" {
    bg0 "#121314"
    bg1 "#17181a"
    surface "#1f2023"
    raised "#282a2e"
    border "#34363b"
    outline "#5a5d66"
    text-hi "#ececee"
    text-md "#b4b6bc"
    text-lo "#9093a0"
    accent "#7aa2ff"
    on-accent "#0b1430"
    focus "#9db8ff"
    success "#5fc98f"
    warn "#e8b95a"
    error "#f07272"
    info "#7aa2ff"
    scrim "#000000b3"
    tone.ready "@success"
    tone.running "@accent"
    tone.downloading "@accent"
    tone.setting_up "@warn"
    tone.update "@warn"
    tone.failed "@error"
    tone.not_installed "@text-lo"
    radius.sm 5
    radius.md 8
    radius.lg 12
    space.1 4
    space.2 8
    space.3 12
    space.4 16
    space.5 20
    space.6 24
    space.7 28
    space.8 32
    elevation.0 0
    elevation.1 1
    elevation.2 2
    elevation.3 3
    stroke.thin 1
    stroke.thick 2
    motion.fast 120
    motion.normal 200
    motion.slow 320
    font.body family="Noto Sans" size=14 weight=400
    font.label family="Noto Sans" size=13 weight=600
    font.title family="Noto Sans" size=18 weight=700
    font.display family="Noto Sans" size=34 weight=800
    font.mono family="JetBrains Mono" size=13 weight=400
}
